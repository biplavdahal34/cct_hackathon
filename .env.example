# ── shared service keys (BEAT's own free-tier accounts) ──────────────────
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY
APIFY_TOKEN=YOUR_APIFY_TOKEN
RESEND_API_KEY=YOUR_RESEND_KEY
OXYLABS_USERNAME=oxylabs_username
OXYLABS_PASSWORD=oxylabs_password

# ── app secrets ──────────────────────────────────────────────────────────
SECRET_KEY=change-me-long-random
# Master key for users' stored API keys. Generate with:
#   venv/bin/flask --app flask_app gen-encryption-key
# Comma-separate several (newest first) while rotating; see `flask rotate-api-keys`.
# Pass it to the container at runtime — never bake it into the image or commit it.
KEY_ENCRYPTION_KEY=
# 1 in production (HTTPS). 0 only for plain-http local development.
SESSION_COOKIE_SECURE=1

# ── usage caps for analyses that spend the shared keys (BYOK users are exempt) ──
FREE_ANALYSES_PER_HOUR=6          # per user
FREE_FACEBOOK_PER_HOUR=2          # per user, Facebook listings (Apify credits)
FREE_ANALYSES_PER_DAY_GLOBAL=100  # everyone combined — set below your Gemini daily quota
FREE_FACEBOOK_PER_DAY_GLOBAL=15   # everyone combined — set below your Apify monthly credits / 30
MAX_ANALYSIS_IMAGES=6             # photos sent to Gemini per listing
REUSE_ANALYSIS_DAYS=7             # show a stored report for the same listing if younger than this (0 = always re-run)

# ── legacy SMTP (unused when RESEND_API_KEY is set) ──────────────────────
MAIL_USERNAME=example@gmail.com
MAIL_PASSWORD=abcd efgh ihjk mnop
